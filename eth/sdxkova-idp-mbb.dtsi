#include "sdxkova.dtsi"

&soc {
	rtl8261_vreg: rtl8261_vreg {
		compatible = "qti-regulator-fixed";
		regulator-name = "rtl8261_vreg";
		gpio = <&tlmm 86 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <700000>;
		regulator-max-microvolt = <700000>;
		enable-active-high;
		regulator-enable-ramp-delay = <80000>;
	};

	rtl8221_vreg: rtl8221_vreg {
		compatible = "qti-regulator-fixed";
		regulator-name = "rtl8221_vreg";
		gpio = <&tlmm 88 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		enable-active-high;
		regulator-enable-ramp-delay = <80000>;
	};
};

&ioss_emac0_rx {
	qcom,compatible-ipa-configs = "default", "qos", "tsn";
};

&ioss_emac0_tx {
	qcom,compatible-ipa-configs = "default", "qos", "tsn";
};

&ioss_emac0_tx1 {
	qcom,ioss-traffic-type = "low-latency";
	qcom,compatible-ipa-configs = "tsn";
};

&emac0 {
	status = "ok";
	phy-mode = "usxgmii";
	managed = "auto";
	snps,reset-active-low;
	snps,reset-gpio = <&tlmm 96 1>;
	snps,reset-delays-us = <1000 40 150000>;
	vreg_emac_phy-supply = <&rtl8261_vreg>;
	phy-handle = <&emac0_phy>;

	pinctrl-0 = <&emac0_mdc_active
		     &emac0_mdio_active
		     &emac0_pin_phy_intr_active
		     &emac0_phy_reset_state_active
		     &emac0_ptp_aux_ts_i_0
		     &emac0_ptp_aux_ts_i_1
		     &emac0_ptp_aux_ts_i_2
		     &emac0_ptp_aux_ts_i_3>;
	pinctrl-1 = <&emac0_mdc_inactive
		     &emac0_mdio_inactive
		     &emac0_pin_phy_intr_inactive
		     &emac0_phy_reset_state_inactive
		     &emac0_ptp_aux_ts_i_0
		     &emac0_ptp_aux_ts_i_1
		     &emac0_ptp_aux_ts_i_2
		     &emac0_ptp_aux_ts_i_3>;

	eth_aux_ts_enabled;
	qcom,aux_ts_num_pins = <4>;
};

&emac0_mdio {
	emac0_phy: emac0_phy {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x2>;
		device_type = "ethernet-phy";
		reset-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000>;
		reset-deassert-us = <150000>;
		interrupts-extended = <&tlmm 97 IRQ_TYPE_EDGE_FALLING>;
	};
};

&emac1 {
	status = "ok";
	phy-mode = "sgmii";
	managed = "auto";
	snps,reset-active-low;
	snps,reset-gpio = <&tlmm 108 1>;
	snps,reset-delays-us = <10000 40 50000>;
	vreg_emac_phy-supply = <&rtl8221_vreg>;
	phy-handle = <&emac1_phy>;
};

&emac1_mdio {
	emac1_phy: emac1_phy {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x1>;
		device_type = "ethernet-phy";
		reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;
		interrupts-extended = <&tlmm 109 IRQ_TYPE_EDGE_FALLING>;
	};
};
