#include "sdxkova.dtsi"

&soc {
	rtl_lgn_vreg: rtl_lgn_vreg {
		compatible = "regulator-fixed";
		regulator-name = "rtl_lgn_vreg";
		gpio = <&tlmm 88 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <700000>;
		regulator-max-microvolt = <700000>;
		enable-active-high;
		regulator-enable-ramp-delay = <100000>;
	};
};

&emac0 {
	status = "ok";
	phy-mode = "sgmii";
	managed = "auto";
	snps,reset-active-low;
	snps,reset-gpio = <&tlmm 96 1>;
	snps,reset-delays-us = <10000 40 50000>;
	vreg_emac_phy-supply = <&rtl_lgn_vreg>;
	phy-handle = <&emac0_phy>;
};

&emac0_mdio {
	emac0_phy: emac0_phy {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x1>;
		device_type = "ethernet-phy";
		reset-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;
		interrupts-extended = <&tlmm 97 IRQ_TYPE_EDGE_FALLING>;
	};
};

&emac1 {
	status = "ok";
	phy-handle = <&emac1_phy>;
	phy-mode = "usxgmii";
	managed = "auto";
	snps,reset-active-low;
	snps,reset-gpio = <&tlmm 108 1>;
	snps,reset-delays-us = <1000 100000 221000>;
	vreg_emac_phy-supply = <&rtl_lgn_vreg>;
};

&emac1_mdio {
	emac1_phy: emac1_phy {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0xc>;
		device_type = "ethernet-phy";
		reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
		reset-assert-us = <1000>;
		reset-deassert-us = <150000>;
		interrupts-extended = <&tlmm 109 IRQ_TYPE_EDGE_FALLING>;
	};
};
