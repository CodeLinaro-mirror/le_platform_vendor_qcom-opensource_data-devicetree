#include "sdxkova.dtsi"

&soc {
        rtl_vreg: rtl_vreg {
                compatible = "qti-regulator-fixed";
                regulator-name = "rtl_vreg";
                gpio = <&tlmm 88 GPIO_ACTIVE_HIGH>;
                regulator-min-microvolt = <1050000>;
                regulator-max-microvolt = <1050000>;
                enable-active-high;
                regulator-enable-ramp-delay = <80000>;
        };

        lgn_vreg: lgn_vreg {
                compatible = "qti-regulator-fixed";
                regulator-name = "lgn_vreg";
                gpio = <&tlmm 86 GPIO_ACTIVE_HIGH>;
                regulator-min-microvolt = <1050000>;
                regulator-max-microvolt = <1050000>;
                enable-active-high;
                regulator-enable-ramp-delay = <80000>;
        };
};

&ioss_emac0_rx {
	qcom,compatible-ipa-configs = "default", "dbl_vlan";
};

&ioss_emac0_tx {
	qcom,compatible-ipa-configs = "default", "dbl_vlan";
};

&emac0 {
        status = "ok";
        phy-mode = "usxgmii";
        managed = "auto";
        snps,reset-active-low;
        snps,reset-gpio = <&tlmm 108 1>;
        snps,reset-delays-us = <1000 40 150000>;
        vreg_emac_phy-supply = <&rtl_vreg>;
        phy-handle = <&emac0_phy>;
        pinctrl-names = "default","init";
        pinctrl-0 = <&emac0_mdc_active
                     &emac0_mdio_active
                     &emac1_pin_phy_intr_active
                     &emac1_phy_reset_state_active>;
        pinctrl-1 = <&emac0_mdc_inactive
                     &emac0_mdio_inactive
                     &emac1_pin_phy_intr_inactive
                     &emac1_phy_reset_state_inactive>;
};

&emac0_mdio {
        emac0_phy: emac0_phy {
                compatible = "ethernet-phy-ieee802.3-c45";
                reg = <0x2>;
                device_type = "ethernet-phy";
                reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
                reset-assert-us = <1000>;
                reset-deassert-us = <150000>;
                interrupts-extended = <&tlmm 109 IRQ_TYPE_EDGE_FALLING>;
        };
};

&ioss_emac1_rx {
	qcom,compatible-ipa-configs = "default";
};

&ioss_emac1_tx {
	qcom,compatible-ipa-configs = "default";
};

&emac1 {
        status = "ok";
        phy-mode = "usxgmii";
        managed = "auto";
        snps,reset-active-low;
        snps,reset-gpio = <&tlmm 96 1>;
        snps,reset-delays-us = <1000 100000 221000>;
        vreg_emac_phy-supply = <&lgn_vreg>;
        phy-handle = <&emac1_phy>;
        pinctrl-names = "default","init";
        pinctrl-0 = <&emac1_mdc_active
                     &emac1_mdio_active
                     &emac0_pin_phy_intr_active
                     &emac0_phy_reset_state_active>;
        pinctrl-1 = <&emac1_mdc_inactive
                     &emac1_mdio_inactive
                     &emac0_pin_phy_intr_inactive
                     &emac0_phy_reset_state_inactive>;
};

&emac1_mdio {
        emac1_phy: emac1_phy {
                compatible = "ethernet-phy-ieee802.3-c45";
                reg = <0xc>;
                device_type = "ethernet-phy";
                reset-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
                reset-assert-us = <1000>;
                reset-deassert-us = <221000>;
        };
};
