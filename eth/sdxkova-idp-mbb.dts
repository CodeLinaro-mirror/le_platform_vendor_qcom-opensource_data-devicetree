/dts-v1/;
/plugin/;
#include "sdxkova-idp-mbb.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SDXKOVA IDP MBB";
	compatible = "qcom,sdxkova-idp",
		"qcom,sdxkova", "qcom,idp";
	qcom,msm-id = <677 0x10000>, <678 0x10000>, <679 0x10000>;
	qcom,board-id = <0x10022 0x300>, <0x10022 0x400>, <0x30022 0x300>, <0x30022 0x400>, <0x40022 0x400>;
};
