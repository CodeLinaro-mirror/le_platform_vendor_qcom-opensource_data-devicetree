DATA_DEVICETREE_ROOT=$(KERNEL_SRC)/$(M)
DATA_KERNEL_ROOT=$(DATA_DEVICETREE_ROOT)/../../data-devicetree

KBUILD_OPTIONS += KBUILD_DTC_INCLUDE=$(DATA_KERNEL_ROOT)
KBUILD_OPTIONS += KBUILD_EXTMOD_DTS=.
KBUILD_OPTIONS += KERNEL_ROOT=$(ROOT_DIR)/$(KERNEL_DIR)
KBUILD_OPTIONS += MODNAME=data-devicetree


all: dtbs

dtbs:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) dtbs $(KBUILD_OPTIONS)

modules_install:
	$(MAKE) M=$(M) -C $(KERNEL_SRC) modules_install

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(M) clean
