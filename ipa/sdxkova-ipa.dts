/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/soc/qcom,ipcc.h>
#include <dt-bindings/interconnect/qcom,sdx75.h>
#include <dt-bindings/clock/qcom,sdx75-gcc.h>
#include <dt-bindings/clock/qcom,rpmh.h>
#include "sdxkova-ipa.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SDXKOVA Soc";
	compatible = "qcom,sdxkova-idp",
			"qcom,sdxkova", "qcom,idp";

	qcom,msm-id = <556 0x10000>, <580 0x10000>, <609 0x10000>, <610 0x10000>;
	qcom,board-id = <0x3010022 0x403>, <0x4020022 0x304>, <0x2010022 0x302>, <0x2010022 0x402>;
};
